# ScamShield Backend Environment Configuration Template
# Copy this file to backend/.env. Never commit real secrets.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

SCAMSHIELD_HMAC_SECRET=replace_with_a_secure_random_server_secret_key

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=65536
HTTP_TIMEOUT_SECONDS=5.0
