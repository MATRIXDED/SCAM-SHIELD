# ScamShield Environment Configuration Template
# Copy this file to .env and customize. Never commit secrets to version control.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Comma-separated list of trusted CORS origins (wildcard '*' is rejected when credentials are enabled)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Secret key used for keyed HMAC-SHA256 message fingerprinting (never log raw text or secrets)
SCAMSHIELD_HMAC_SECRET=replace_with_a_secure_random_server_secret_key

# Supabase Cloud Configuration (Optional: defaults to Local SQLite Demo mode)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
# Service role key must NEVER be exposed to frontend; server-side use only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=65536
HTTP_TIMEOUT_SECONDS=5.0
